TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# OAuth user token for the bot/broadcaster account.
# Chat: chat:read chat:edit
# EventSub: moderator:read:followers (follow) · channel:read:subscriptions (subscribe)
# Raid EventSub needs no extra scope. Format: oauth:xxxx or raw token.
TWITCH_BOT_TOKEN=
TWITCH_BOT_USERNAME=
TWITCH_CHANNEL=
# Optional Helix IDs (resolved from TWITCH_CHANNEL / TWITCH_BOT_USERNAME when omitted)
TWITCH_BROADCASTER_USER_ID=
TWITCH_MODERATOR_USER_ID=
PORT=3000
# Skip Twitch chat + EventSub; use /api/test/* only
CHATQUEST_MOCK=0
# Quest boost amounts from EventSub events
CHATQUEST_FOLLOW_BOOST=3
CHATQUEST_SUB_BOOST=6
CHATQUEST_RAID_BOOST_CAP=15
